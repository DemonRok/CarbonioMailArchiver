<Window x:Class="CarbonioMailArchiver.App.FolderDeleteConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conferma spostamento cartelle vuote nel cestino"
        Width="520"
        Height="280"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        SizeToContent="Manual">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="SummaryText"
                   FontSize="15"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12" />

        <Border Grid.Row="1" BorderBrush="#D0D0D0" BorderThickness="1" Padding="10" Background="#FAFAFA">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="DetailText" TextWrapping="Wrap" Foreground="#444" />
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="ConfirmButton"
                    Content="Sposta nel cestino"
                    Width="150"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Click="ConfirmButton_OnClick" />
            <Button Content="Annulla"
                    Width="100"
                    IsCancel="True"
                    Click="CancelButton_OnClick" />
        </StackPanel>
    </Grid>
</Window>
