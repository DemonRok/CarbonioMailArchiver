<Window x:Class="CarbonioMailArchiver.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="866" MinHeight="580" Width="1118" MinWidth="780">
    <Window.Resources>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="8,2" />
            <Style.Triggers>
                <Trigger Property="Content" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OperationTextBlockStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#666" />
            <Setter Property="Margin" Value="0,2,12,0" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Setter Property="Margin" Value="0" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="pack://application:,,,/CarbonioMailArchiver.App;component/Assets/app-icon.png" Width="40" Height="40" VerticalAlignment="Top" Margin="0,2,12,0" />
            <StackPanel Grid.Column="1">
                <TextBlock Text="Carbonio Mail Archiver" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="Ricerca, conteggio, spostamento, download e compressione delle email Carbonio via API server, con log e report CSV." Foreground="#555" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="1">
            <TabItem Header="Connessione">
                <Grid Margin="0,18,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="360" IsEnabled="{Binding IsOperationIdle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Base URL" VerticalAlignment="Center" Margin="0,0,12,12" />
                            <TextBox Grid.Column="1" Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                            <TextBlock Grid.Row="1" Text="SOAP URL" VerticalAlignment="Center" Margin="0,0,12,12" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SoapUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                            <TextBlock Grid.Row="2" Text="Account email" VerticalAlignment="Center" Margin="0,0,12,12" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                            <TextBlock Grid.Row="3" Text="Password" VerticalAlignment="Center" Margin="0,0,12,12" />
                            <PasswordBox Grid.Row="3" Grid.Column="1" x:Name="PasswordInput" PasswordChanged="PasswordInput_OnPasswordChanged" Margin="0,0,0,12" />

                            <CheckBox Grid.Row="4" Grid.Column="1" Content="Ricorda password con DPAPI per l'utente Windows corrente" IsChecked="{Binding RememberCredentials}" Margin="0,0,0,10" />

                            <TextBlock Grid.Row="5" Text="Cerca prima del (gg/MM/aaaa)" VerticalAlignment="Center" Margin="0,0,12,12" />
                            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBox Text="{Binding SearchBeforeDate, UpdateSourceTrigger=PropertyChanged}"
                                         Width="120"
                                         HorizontalAlignment="Left"
                                         IsEnabled="{Binding IsSearchBeforeDateEnabled}" />
                                <CheckBox Content="Scarica tutta la casella ignorando la data"
                                          IsChecked="{Binding DownloadEntireMailbox}"
                                          VerticalAlignment="Center"
                                          Margin="16,0,0,0" />
                            </StackPanel>

                            <TextBlock Grid.Row="6" Text="Sorgente spostamento" VerticalAlignment="Center" Margin="0,0,12,12" />
                            <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,12">
                                <ComboBox ItemsSource="{Binding AvailableFolders}"
                                          SelectedItem="{Binding SelectedSourceFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          DisplayMemberPath="DisplayName"
                                          MinWidth="340"
                                          HorizontalAlignment="Left" />
                                <Button Content="Cestina vuote"
                                        Command="{Binding DeleteSourceFolderIfEmptyCommand}"
                                        Width="120"
                                        Margin="10,0,0,0" />
                                <CheckBox Content="Includi sottocartelle"
                                          IsChecked="{Binding IncludeSourceSubfolders}"
                                          VerticalAlignment="Center"
                                          Margin="16,0,0,0" />
                            </StackPanel>

                            <CheckBox Grid.Row="7"
                                      Grid.Column="1"
                                      Content="Usa Archivio come cartella da scaricare"
                                      IsChecked="{Binding UseArchiveDestination}"
                                      Margin="0,0,0,10" />

                            <TextBlock Grid.Row="8" Text="Cartella da scaricare" VerticalAlignment="Center" Margin="0,0,12,12" />
                            <ComboBox Grid.Row="8" Grid.Column="1"
                                      ItemsSource="{Binding AvailableFolders}"
                                      SelectedItem="{Binding SelectedDestinationFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding IsDestinationFolderSelectionEnabled}"
                                      MinWidth="340"
                                      HorizontalAlignment="Left"
                                      Margin="0,0,0,12">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.UseArchiveDestination, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}" Value="True">
                                                            <Setter Property="Text" Value="/Archive" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Row="8"
                                    Grid.Column="1"
                                    Content="Cestina vuote"
                                    Command="{Binding DeleteDestinationFolderIfEmptyCommand}"
                                    IsEnabled="{Binding IsDestinationFolderSelectionEnabled}"
                                    Width="120"
                                    HorizontalAlignment="Left"
                                    Margin="350,0,0,12" />

                            <WrapPanel Grid.Row="9" Grid.Column="1" VerticalAlignment="Top" Margin="0,8,0,4">
                                <Button Content="Test connessione" Command="{Binding TestConnectionCommand}" Width="140" Margin="0,0,8,8" />
                                <Button Content="Carica cartelle" Command="{Binding LoadFoldersCommand}" Width="140" Margin="0,0,8,8" />
                                <Button Content="Test ricerca" Command="{Binding TestSearchCommand}" Width="140" Margin="0,0,8,8" />
                                <Button Content="Simula spostamento" Command="{Binding SimulateMoveCommand}" Width="140" Margin="0,0,8,8" />
                                <Button Content="Sposta preview" Command="{Binding MovePreviewCommand}" Width="140" Margin="0,0,8,8" />
                                <Button Content="Sposta tutti" Command="{Binding MoveAllSearchResultsCommand}" Width="140" Margin="0,0,8,8" />
                                <Button Content="Scarica EML" Command="{Binding DownloadMessagesCommand}" Width="140" Margin="0,0,8,8" />
                                <Button Content="Verifica EML" Command="{Binding VerifyDownloadedMessagesCommand}" Width="140" Margin="0,0,8,8" />
                                <Button Content="Comprimi EML" Command="{Binding CompressMessagesCommand}" IsEnabled="{Binding CanCompressMessages}" Width="140" Margin="0,0,8,8" />
                                <Button Content="Salva" Command="{Binding SaveCommand}" Width="140" Margin="0,0,8,8" />
                            </WrapPanel>
                        </Grid>
                    </ScrollViewer>

                    <Grid Grid.Row="1" Margin="0,6,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.ColumnSpan="2" Margin="0,0,0,3">
                            <TextBlock Text="{Binding OperationElapsedText}"
                                       VerticalAlignment="Center"
                                       Foreground="#666" />
                            <TextBlock Text="{Binding OperationSpeedText}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Foreground="#666" />
                        </Grid>
                        <Grid Grid.Row="1" Grid.ColumnSpan="2">
                            <ProgressBar Minimum="0"
                                         Maximum="100"
                                         Height="20"
                                         IsIndeterminate="{Binding IsMoveProgressIndeterminate, Mode=OneWay}"
                                         Value="{Binding MoveProgressPercentage, Mode=OneWay}" />
                            <TextBlock Text="{Binding MoveProgressPercentText}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="#222" />
                        </Grid>
                        <TextBlock Grid.Row="2"
                                   Text="{Binding MoveBatchText}"
                                   Foreground="#333"
                                   Style="{StaticResource OperationTextBlockStyle}"
                                   Margin="0,4,12,0" />
                        <TextBlock Grid.Row="3"
                                   Text="{Binding MoveDetailText}"
                                   Style="{StaticResource OperationTextBlockStyle}"
                                   Foreground="#555" />
                        <TextBlock Grid.Row="4"
                                   Text="{Binding OperationSkippedText}"
                                   Style="{StaticResource OperationTextBlockStyle}" />
                        <TextBlock Grid.Row="5"
                                   Text="{Binding OperationFolderText}"
                                   TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource OperationTextBlockStyle}" />
                        <TextBlock Grid.Row="6"
                                   Text="{Binding OperationFileText}"
                                   TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource OperationTextBlockStyle}" />
                        <TextBlock Grid.Row="7"
                                   Text="{Binding OperationDownloadedText}"
                                   Style="{StaticResource OperationTextBlockStyle}" />
                        <TextBlock Grid.Row="8"
                                   Text="{Binding OperationEtaText}"
                                   Style="{StaticResource OperationTextBlockStyle}" />
                        <TextBlock Grid.Row="9"
                                   Text="{Binding OperationMetricsText}"
                                   Style="{StaticResource OperationTextBlockStyle}" />
                        <Button Grid.Row="3"
                                Grid.Column="1"
                                Content="Annulla"
                                Command="{Binding CancelMoveCommand}"
                                Width="96"
                                VerticalAlignment="Top"
                                Margin="0,4,0,0" />
                    </Grid>

                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding PreviewMessages}"
                              IsEnabled="{Binding IsOperationIdle}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              MinHeight="260"
                              Margin="0,5,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Data" Binding="{Binding Date}" Width="150" />
                            <DataGridTextColumn Header="Mittente" Binding="{Binding From}" Width="220" />
                            <DataGridTextColumn Header="Oggetto" Binding="{Binding Subject}" Width="*" />
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="110" />
                            <DataGridTextColumn Header="Cartella" Binding="{Binding FolderPath}" Width="160" />
                            <DataGridTextColumn Header="Folder ID" Binding="{Binding FolderId}" Width="80" />
                            <DataGridTextColumn Header="Dim." Binding="{Binding Size}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Configurazione" IsEnabled="{Binding IsOperationIdle}">
                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Timeout SOAP" VerticalAlignment="Center" Margin="0,0,12,12" />
                            <TextBox Grid.Column="1" Text="{Binding TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left" Margin="0,0,0,12" PreviewTextInput="NumericTextBox_OnPreviewTextInput" DataObject.Pasting="NumericTextBox_OnPasting" />

                    <TextBlock Grid.Row="1" Text="Parametri ricerca e move" VerticalAlignment="Center" Margin="0,0,12,12" />
                    <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Preview (1-100)" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Grid Grid.Column="1" Margin="0,0,20,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="18" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding PreviewMessageLimit, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" PreviewTextInput="NumericTextBox_OnPreviewTextInput" DataObject.Pasting="NumericTextBox_OnPasting" />
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <RepeatButton Content="▲" Command="{Binding IncreasePreviewMessageLimitCommand}" Delay="350" Interval="70" FontSize="8" Padding="0" />
                                <RepeatButton Grid.Row="1" Content="▼" Command="{Binding DecreasePreviewMessageLimitCommand}" Delay="350" Interval="70" FontSize="8" Padding="0" />
                            </Grid>
                        </Grid>

                        <TextBlock Grid.Column="2" Text="Batch move (10-500)" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Grid Grid.Column="3" Margin="0,0,20,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="18" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding BatchSize, UpdateSourceTrigger=LostFocus}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" PreviewTextInput="NumericTextBox_OnPreviewTextInput" DataObject.Pasting="NumericTextBox_OnPasting" />
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <RepeatButton Content="▲" Command="{Binding IncreaseBatchSizeCommand}" Delay="350" Interval="70" FontSize="8" Padding="0" />
                                <RepeatButton Grid.Row="1" Content="▼" Command="{Binding DecreaseBatchSizeCommand}" Delay="350" Interval="70" FontSize="8" Padding="0" />
                            </Grid>
                        </Grid>

                        <TextBlock Grid.Column="4" Text="Da spostare (0=tutte)" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Grid Grid.Column="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="66" />
                                <ColumnDefinition Width="18" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding MaxMessagesToMove, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" PreviewTextInput="NumericTextBox_OnPreviewTextInput" DataObject.Pasting="NumericTextBox_OnPasting" />
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <RepeatButton Content="▲" Command="{Binding IncreaseMaxMessagesToMoveCommand}" Delay="350" Interval="70" FontSize="8" Padding="0" />
                                <RepeatButton Grid.Row="1" Content="▼" Command="{Binding DecreaseMaxMessagesToMoveCommand}" Delay="350" Interval="70" FontSize="8" Padding="0" />
                            </Grid>
                        </Grid>
                    </Grid>

                    <TextBlock Grid.Row="2" Text="Cartella download EML" VerticalAlignment="Center" Margin="0,0,12,12" />
                    <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding DownloadRootDirectory, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1"
                                Content="Sfoglia..."
                                Command="{Binding BrowseDownloadRootDirectoryCommand}"
                                Width="96"
                                Margin="8,0,0,0" />
                    </Grid>

                    <TextBlock Grid.Row="3" Text="Velocita' download" VerticalAlignment="Center" Margin="0,0,12,12" />
                    <Grid Grid.Row="3" Grid.Column="1" Margin="0,0,0,12" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="74" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding DownloadSpeedLimitKbps, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" PreviewTextInput="NumericTextBox_OnPreviewTextInput" DataObject.Pasting="NumericTextBox_OnPasting" />
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <RepeatButton Content="▲" Command="{Binding IncreaseDownloadSpeedLimitCommand}" Delay="350" Interval="70" FontSize="8" Padding="0" />
                            <RepeatButton Grid.Row="1" Content="▼" Command="{Binding DecreaseDownloadSpeedLimitCommand}" Delay="350" Interval="70" FontSize="8" Padding="0" />
                        </Grid>
                        <TextBlock Grid.Column="2" Text="KB/s (0 = senza limite)" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#555" />
                    </Grid>

                    <TextBlock Grid.Row="4" Text="Retry download" VerticalAlignment="Center" Margin="0,0,12,12" />
                    <Grid Grid.Row="4" Grid.Column="1" Margin="0,0,0,12" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="74" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="74" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Tentativi (1-10)" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Grid.Column="1" Text="{Binding DownloadRetryCount, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" PreviewTextInput="NumericTextBox_OnPreviewTextInput" DataObject.Pasting="NumericTextBox_OnPasting" />
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <RepeatButton Content="▲" Command="{Binding IncreaseDownloadRetryCountCommand}" Delay="350" Interval="70" FontSize="8" Padding="0" />
                            <RepeatButton Grid.Row="1" Content="▼" Command="{Binding DecreaseDownloadRetryCountCommand}" Delay="350" Interval="70" FontSize="8" Padding="0" />
                        </Grid>
                        <TextBlock Grid.Column="3" Text="Delay base sec." VerticalAlignment="Center" Margin="18,0,8,0" />
                        <TextBox Grid.Column="4" Text="{Binding DownloadRetryDelaySeconds, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" PreviewTextInput="NumericTextBox_OnPreviewTextInput" DataObject.Pasting="NumericTextBox_OnPasting" />
                        <Grid Grid.Column="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <RepeatButton Content="▲" Command="{Binding IncreaseDownloadRetryDelayCommand}" Delay="350" Interval="70" FontSize="8" Padding="0" />
                            <RepeatButton Grid.Row="1" Content="▼" Command="{Binding DecreaseDownloadRetryDelayCommand}" Delay="350" Interval="70" FontSize="8" Padding="0" />
                        </Grid>
                        <TextBlock Grid.Column="6" Text="progressivo: delay × tentativo" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#555" />
                    </Grid>

                    <TextBlock Grid.Row="5" Text="Compressione 7z" VerticalAlignment="Center" Margin="0,0,12,12" />
                    <ComboBox Grid.Row="5"
                              Grid.Column="1"
                              ItemsSource="{Binding SevenZipCompressionLevels}"
                              SelectedItem="{Binding SelectedSevenZipCompressionLevel, Mode=TwoWay}"
                              Width="160"
                              HorizontalAlignment="Left"
                              Margin="0,0,0,12" />

                    <CheckBox Grid.Row="6"
                              Grid.Column="1"
                              Content="Carica cartelle all'avvio se la password e' disponibile"
                              IsChecked="{Binding AutoLoadFoldersOnStartup}"
                              Margin="0,0,0,10" />
                    <CheckBox Grid.Row="7"
                              Grid.Column="1"
                              Content="Mostra anche cartelle speciali (Calendar, Drafts, Junk, Trash, Chats, Emailed Contacts)"
                              IsChecked="{Binding ShowSpecialFolders}"
                              Margin="0,0,0,10" />
                    <CheckBox Grid.Row="8"
                              Grid.Column="1"
                              Content="Logging diagnostico API/SOAP (senza password)"
                              IsChecked="{Binding DiagnosticSoapLoggingEnabled}"
                              Margin="0,0,0,10" />
                    <CheckBox Grid.Row="9"
                              Grid.Column="1"
                              Content="Chiedi se esportare il report CSV al termine dello spostamento"
                              IsChecked="{Binding PromptReportExportAfterMove}"
                              Margin="0,0,0,10" />
                    <StackPanel Grid.Row="10" Grid.ColumnSpan="2" Margin="0,8,0,0">
                        <TextBlock Text="Opzioni disponibili" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBlock Text="• Timeout SOAP: tempo massimo di attesa per ogni richiesta al server." Foreground="#555" TextWrapping="Wrap" Margin="0,0,0,4" />
                        <TextBlock Text="• Preview: quante email vengono mostrate dal Test ricerca, senza spostarle; valore da 1 a 100." Foreground="#555" TextWrapping="Wrap" Margin="0,0,0,4" />
                        <TextBlock Text="• Batch move: quante email vengono inviate al server per ogni richiesta; valore da 10 a 500, predefinito 250." Foreground="#555" TextWrapping="Wrap" Margin="0,0,0,4" />
                        <TextBlock Text="• Da spostare: limite totale di email da muovere; 0 significa tutte quelle trovate." Foreground="#555" TextWrapping="Wrap" Margin="0,0,0,4" />
                        <TextBlock Text="• Cartella download EML: directory locale per i file scaricati." Foreground="#555" TextWrapping="Wrap" Margin="0,0,0,4" />
                        <TextBlock Text="• Velocita' download: limite in KB/s; 0 lascia il download senza limite." Foreground="#555" TextWrapping="Wrap" Margin="0,0,0,4" />
                        <TextBlock Text="• Retry download: tentativi e ritardo progressivo per i download falliti." Foreground="#555" TextWrapping="Wrap" Margin="0,0,0,4" />
                        <TextBlock Text="• Compressione 7z: livello usato per gli archivi creati dai download EML." Foreground="#555" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
                            <Button Content="Ripristina default"
                                    Command="{Binding RestoreConfigurationDefaultsCommand}"
                                    Width="140"
                                    Margin="0,0,10,0" />
                            <Button Content="Salva configurazione"
                                    Command="{Binding SaveCommand}"
                                    Width="140" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Log">
                <Grid Margin="0,18,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="Aggiorna" Command="{Binding RefreshLogsCommand}" Width="96" Margin="0,0,12,0" IsEnabled="{Binding IsOperationIdle}" />
                        <Button Content="Copia tutto" Command="{Binding CopyLogsCommand}" Width="96" Margin="0,0,12,0" IsEnabled="{Binding IsOperationIdle}" />
                        <Button Content="Cancella log" Command="{Binding ClearLogsCommand}" Width="110" Margin="0,0,12,0" IsEnabled="{Binding IsOperationIdle}" />
                        <ComboBox Width="140"
                                  Margin="0,0,12,0"
                                  ItemsSource="{Binding LogLevelFilters}"
                                  SelectedItem="{Binding SelectedLogLevelFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="{Binding LogDirectory}" VerticalAlignment="Center" Foreground="#555" />
                    </StackPanel>
                    <ListView Grid.Row="1"
                              ItemsSource="{Binding RecentLogEntriesView}"
                              BorderThickness="1"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              FontSize="12"
                              Background="White"
                              IsTextSearchEnabled="False"
                              PreviewMouseDoubleClick="LogListView_OnPreviewMouseDoubleClick">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="80">
                                    <GridViewColumn.Header>
                                        <GridViewColumnHeader Content="Ora" Tag="TimestampSortKey" Click="LogColumnHeader_OnClick" />
                                    </GridViewColumn.Header>
                                    <GridViewColumn.DisplayMemberBinding>
                                        <Binding Path="Timestamp" />
                                    </GridViewColumn.DisplayMemberBinding>
                                </GridViewColumn>
                                <GridViewColumn Width="86">
                                    <GridViewColumn.Header>
                                        <GridViewColumnHeader Content="Livello" Tag="LevelSortKey" Click="LogColumnHeader_OnClick" />
                                    </GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Level}" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="Foreground" Value="#444" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Level}" Value="Information">
                                                                <Setter Property="Foreground" Value="#356AC3" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                                <Setter Property="Foreground" Value="#A06B00" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="Error">
                                                                <Setter Property="Foreground" Value="#B00020" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="220">
                                    <GridViewColumn.Header>
                                        <GridViewColumnHeader Content="Sorgente" Tag="SourceSortKey" Click="LogColumnHeader_OnClick" />
                                    </GridViewColumn.Header>
                                    <GridViewColumn.DisplayMemberBinding>
                                        <Binding Path="Source" />
                                    </GridViewColumn.DisplayMemberBinding>
                                </GridViewColumn>
                                <GridViewColumn Width="520">
                                    <GridViewColumn.Header>
                                        <GridViewColumnHeader Content="Messaggio" Tag="MessageSortKey" Click="LogColumnHeader_OnClick" />
                                    </GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#222" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>

            <TabItem Header="Info" IsEnabled="{Binding IsOperationIdle}">
                <ScrollViewer Margin="0,12,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                    <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,18">
                        <TextBlock Text="Carbonio Mail Archiver" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding AppVersion, StringFormat=Versione {0}}" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding AppDescription}" FontSize="13" FontWeight="SemiBold" />
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="Licenza" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,8" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LicenseName}" VerticalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Grid.Row="2" Text="Copyright" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,8" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CopyrightText}" VerticalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Grid.Row="3" Text="Configurazione" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,8" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ConfigurationPath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ConfigurationPath}" VerticalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Grid.Row="4" Text="AppData" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,8" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ApplicationDirectory}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ApplicationDirectory}" VerticalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Grid.Row="5" Text="Log" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,8" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding LogDirectory}" TextTrimming="CharacterEllipsis" ToolTip="{Binding LogDirectory}" VerticalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Grid.Row="6" Text="Report" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,8" />
                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding ReportDirectory}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ReportDirectory}" VerticalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Grid.Row="7" Text="Eseguibile" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,14" />
                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding ExecutableDirectory}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ExecutableDirectory}" VerticalAlignment="Center" Margin="0,0,0,14" />

                    <WrapPanel Grid.Row="8" Grid.ColumnSpan="2" Margin="0,0,0,8">
                        <Button Content="Apri AppData" Command="{Binding OpenAppDataCommand}" Width="178" Margin="0,0,10,8" />
                        <Button Content="Apri Log" Command="{Binding OpenLogsCommand}" Width="178" Margin="0,0,10,8" />
                        <Button Content="Apri Download" Command="{Binding OpenDownloadsCommand}" Width="178" Margin="0,0,10,8" />
                        <Button Content="Apri Report" Command="{Binding OpenReportsCommand}" Width="178" Margin="0,0,10,8" />
                        <Button Content="Apri ultimo report" Command="{Binding OpenLastReportCommand}" Width="178" Margin="0,0,10,8" />
                        <Button Content="Apri Repository" Command="{Binding OpenRepositoryCommand}" Width="178" Margin="0,0,10,8" />
                        <Button Content="Segnala problema" Command="{Binding ReportIssueCommand}" Width="178" Margin="0,0,10,8" />
                        <Button Content="Apri Release" Command="{Binding OpenReleasesCommand}" Width="178" Margin="0,0,10,8" />
                        <Button Content="Apri Licenza" Command="{Binding OpenLicenseCommand}" Width="178" Margin="0,0,10,8" />
                    </WrapPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" BorderBrush="#DDD" BorderThickness="1,0,0,0" Padding="0,12,0,0">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="#333" />
        </Border>
    </Grid>
</Window>
